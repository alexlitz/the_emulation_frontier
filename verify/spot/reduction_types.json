  "feature": "switch_lora",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:tied_emb:target",
  "kind": "feature",
  "note": "tied embeddings (lm_head = E^T): a tied target is an untied host with lm_head := E^T; a tied host's output table IS its input table -- a target with its own lm_head would need a second table in the re",
  "headline": true,
  "feature": "tied_emb",
  "side": "target",
  "rule": "free"
 },
 {
