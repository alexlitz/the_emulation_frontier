 },
 {
  "id": "feature:engram:host",
  "kind": "feature",
  "note": "hashed n-gram memory added to the residual (Engram, DeepSeek-V4.1): a token embedding cannot read the previous tokens; zero its output to switch it off",
  "headline": true,
  "feature": "engram",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:out_gate:host",
  "kind": "feature",
  "note": "attention output gate o * sigmoid(W_g x) (Qwen3-Next / 3.5 attn_output_gate, Laguna, Step-3.5, MiniCPM-SALA, Kimi MLA, ...): a data-dependent product no ungated layer forms; a gated host sets W_g = 0 ",
  "headline": true,
  "feature": "out_gate",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:ple:host",
  "kind": "feature",
  "note": "per-layer token embeddings fed into every layer (Gemma-3n / Gemma-4 E-models PLE, Qwen4-exp): carrying them in the residual is seen by every pre-norm; zero them to switch off",
  "headline": true,
  "feature": "ple",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:router_bias:host",
  "kind": "feature",
  "note": "a selection-only expert bias (aux-loss-free balancing: topk_method noaux_tc, e_score_correction_bias, moe_router_enable_expert_bias, use_routing_bias, ...): the experts are SELECTED on l + b but weigh",
  "headline": true,
  "feature": "router_bias",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:router_group:host",
  "kind": "feature",
  "note": "group-limited top-k (n_group / topk_group): priced by moe_why (group routing: the same group-score code, m = 1 under a top-2-sum score, the host's experts in m x n_group equal groups)",
  "headline": true,
  "feature": "router_group",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:router_group:target",
  "kind": "feature",
  "note": "group-limited top-k (n_group / topk_group): priced by moe_why (group routing: the same group-score code, m = 1 under a top-2-sum score, the host's experts in m x n_group equal groups)",
  "headline": true,
  "feature": "router_group",
  "side": "target",
  "rule": "free"
 },
 {
  "id": "feature:router_sigmoid:host",
  "kind": "feature",
  "note": "sigmoid expert scores (DeepSeek-V3, GLM-4.5, Kimi-K2, ...): priced by moe_why (router score): a softmax router's weights cannot equal sigmoid ones for linear logits, and the sigmoid -> e^z limit is a ",
  "headline": true,
  "feature": "router_sigmoid",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:router_sigmoid:target",
  "kind": "feature",
  "note": "sigmoid expert scores (DeepSeek-V3, GLM-4.5, Kimi-K2, ...): priced by moe_why (router score): a softmax router's weights cannot equal sigmoid ones for linear logits, and the sigmoid -> e^z limit is a ",
  "headline": true,
  "feature": "router_sigmoid",
  "side": "target",
  "rule": "free"
 },
 {
  "id": "feature:router_sqrtsoftplus:host",
  "kind": "feature",
  "note": "expert scores sqrt(softplus(l)) (DeepSeek-V4 scoring_func sqrtsoftplus): priced by moe_why (router score; V4's ACT2FN[scoring_func] takes sigmoid or sqrtsoftplus from the config)",
  "headline": true,
  "feature": "router_sqrtsoftplus",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:router_sqrtsoftplus:target",
  "kind": "feature",
  "note": "expert scores sqrt(softplus(l)) (DeepSeek-V4 scoring_func sqrtsoftplus): priced by moe_why (router score; V4's ACT2FN[scoring_func] takes sigmoid or sqrtsoftplus from the config)",
  "headline": true,
  "feature": "router_sqrtsoftplus",
  "side": "target",
  "rule": "free"
 },
 {
  "id": "feature:selfcond:host",
  "kind": "feature",
  "note": "self-conditioning (DiffusionGemma, LLaDA2.1-ORL, QwenDLM-ORL): the previous step's logits fed back as an extra input, softmax(prev) E -> MLP -> added; no host without it reads that input; a self-condi",
  "headline": true,
  "feature": "selfcond",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:shared_gate:host",
  "kind": "feature",
  "note": "a sigmoid gate on the shared expert, sigmoid(w . x) * shared(x) (Qwen1.5 / 2-MoE, Qwen3-Next, Qwen3.5-MoE, Qwen4-exp): a data-dependent product an ungated shared expert does not form; a gated host set",
  "headline": true,
