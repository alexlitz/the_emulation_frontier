  "feature": "bias_qkv",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:dsa:host",
  "kind": "feature",
  "note": "DeepSeek sparse attention (an indexer keeps the index_topk best keys per query): treated as dense attention -- exact while the context is <= index_topk; a DSA host sets index_topk >= the context",
  "headline": true,
  "feature": "dsa",
  "side": "host",
  "rule": "free"
 },
 {
  "id": "feature:dsa:target",
  "kind": "feature",
